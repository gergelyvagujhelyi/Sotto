<?xml version="1.0" encoding="utf-8"?>
<!-- The list of chats and message requests. -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="conversations_title">Chats</string>
    <string name="conversations_new_chat">New chat</string>
    <string name="conversations_empty_title">No conversations yet</string>
    <!-- Card in the chat list while Android may hold Sotto back in the background -->
    <string name="conversations_background_title">Let Sotto run in the background</string>
    <string name="conversations_background_body">Until you do, Android can hold back new messages and calls until you open Sotto.</string>
    <string name="conversations_background_allow">Allow</string>
    <string name="conversations_background_later">Not now</string>
    <!-- The card again, after Sotto noticed a message that waited long on the relay -->
    <plurals name="conversations_background_late_minutes">
        <item quantity="one">A message arrived %d minute late</item>
        <item quantity="other">A message arrived %d minutes late</item>
    </plurals>
    <plurals name="conversations_background_late_hours">
        <item quantity="one">A message arrived %d hour late</item>
        <item quantity="other">A message arrived %d hours late</item>
    </plurals>
    <string name="conversations_background_late_body">Android may have held Sotto back until you opened it. Let Sotto run in the background so messages arrive at once.</string>
    <string name="conversations_empty_body">Tap New chat and enter someone\'s share code to start a private, end-to-end encrypted conversation.</string>
    <string name="conversations_requests">Message requests</string>
    <string name="conversations_chats">Chats</string>
    <string name="conversations_request_subtitle">Wants to message you</string>
    <string name="conversations_encrypted">Encrypted</string>

    <!-- Time of a chat's last message before today (java.time patterns, names in chat_date_locale). -->
    <string name="conversations_date_this_year">dd MMM</string>
    <string name="conversations_date_other_year">dd/MM/yyyy</string>
</resources>
