    <string name="settings_rotate_title">Rotate identity keys?</string>
    <string name="settings_rotate_text">This generates new signing and encryption keys and a new share code. Every contact sees that your keys changed and has to accept them before your chats continue. Only needed if you think your keys were exposed.</string>
