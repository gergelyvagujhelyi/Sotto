    <!-- Asked before turning the background connection on, on a phone that has Google push -->
    <string name="settings_background_not_needed_title">Not needed on this phone</string>
    <string name="settings_background_not_needed_text">Messages and calls already reach this phone through Google push. The background connection keeps a connection to your relay open all the time: it uses more battery, and on a Wi-Fi that keeps dropping it can get in the way of sending.</string>
    <string name="settings_background_turn_on_anyway">Turn on anyway</string>

    <!-- Connection -->
    <string name="settings_section_connection">Connection</string>
    <string name="settings_background_connection">Background connection</string>
    <string name="settings_background_connection_subtitle">Get messages and calls while the app is closed. Shows a permanent notification and uses more battery.</string>
    <string name="settings_background_recommended_no_relay_push">Recommended: your relay can\'t wake the app with push.</string>
    <string name="settings_background_recommended_no_google_push">Recommended on this phone: it has no Google push.</string>
    <string name="settings_allow_background">Allow background activity</string>
    <string name="settings_allow_background_subtitle">Until you do, Android can delay messages and calls</string>
    <string name="settings_relay">Relay</string>
    <string name="settings_relay_subtitle">%1$s · to use another relay, wipe this app\'s data and set it up again</string>

    <!-- Calls -->
    <string name="settings_section_calls">Calls</string>
    <string name="settings_hq_calls">High-quality calls</string>
    <string name="settings_hq_calls_subtitle">Fuller sound in calls with someone who has this on too; the call screen then shows HD. Uses about a quarter more data.</string>
    <string name="settings_level_voices">Level quiet voices</string>
    <string name="settings_level_voices_subtitle">Lifts a quiet voice in a call to a normal level. Without it, Louder on the call screen lifts one person\'s voice, and is remembered for them.</string>
    <string name="settings_webrtc_voice">WebRTC voice processing</string>
    <string name="settings_webrtc_voice_subtitle">Your microphone goes through WebRTC\'s echo cancellation, noise suppression and volume instead of the phone\'s own. Try it if people hear an echo or you sound too quiet. From the next call.</string>

    <!-- Privacy -->
    <string name="settings_section_privacy">Privacy</string>
    <string name="settings_read_receipts">Read receipts</string>
    <string name="settings_read_receipts_subtitle">Let others know when you\'ve read their messages. Works both ways: with this off you won\'t see when they read yours.</string>
    <string name="settings_screen_security">Screen security</string>
    <string name="settings_screen_security_subtitle">Block screenshots and app switcher preview</string>
    <string name="settings_direct_calls">Direct calls</string>
    <string name="settings_direct_calls_subtitle">When a contact also has this on, call audio and files go straight between your phones instead of through the relay: better sound, less relay data, but each of you can see the other\'s IP addresses (internet, home network and mobile). Calls and files with people who aren\'t your contacts always use the relay.</string>

