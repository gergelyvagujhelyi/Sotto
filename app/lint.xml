<?xml version="1.0" encoding="UTF-8"?>
<!-- Lint checks this app answers on purpose, with the reason. -->
<lint>
    <!-- Release builds are ARM only (app/build.gradle.kts): x86_64's native code more than
         doubled the APK, for emulators and rare Intel devices. Debug builds keep every ABI. -->
    <issue id="ChromeOsAbiSupport" severity="ignore" />
    <!-- Sotto asks to stop battery optimisation (Settings, and a card in the chat list): without
         it Android and phone makers' battery savers hold messages and calls back until the app is
         opened, and phones without Google push rely on the background connection. What the
         exemption is for. Said here because lint once ignored a @SuppressLint on the request. -->
    <issue id="BatteryLife">
        <ignore path="src/main/kotlin/com/sotto/app/ui/components/BackgroundActivity.kt" />
    </issue>
</lint>
