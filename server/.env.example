# Sotto Relay Server Configuration
# Copy to .env and fill in values.

DATABASE_URL=sqlite+aiosqlite:///./sotto.db
# For PostgreSQL (recommended for production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/sotto

# Firebase Cloud Messaging (optional — set path to service account JSON)
# FIREBASE_CREDENTIALS=./firebase-service-account.json

# Server
HOST=0.0.0.0
PORT=8000
# Set to true ONLY for local development
DEBUG=false

# Sign-up: new accounts need a one-time invite from a member (POST /v1/invites).
# The relay's first account needs none. false lets anyone who knows the address join.
# INVITE_ONLY=true

# Key lookups (someone's keys by share code or user id) by signed-in members only. Apps sign
# them in since 0.7.11: turn this on once every phone on the relay runs 0.7.11 or later.
# It only keeps outsiders out with INVITE_ONLY=true: on an open relay anyone can sign up.
# KEY_LOOKUP_AUTH=false

# Invite links (https://<relay>/invite#...) open the app directly through Android App Links.
# The relay names the app in /.well-known/assetlinks.json: the official Sotto app by default.
# If you build the app yourself, give its package and the SHA-256 fingerprint(s) of its
# signing certificate, comma-separated, and where the invite page sends people to get the app.
# APP_LINK_PACKAGE=com.example.sotto
# APP_LINK_CERT_FINGERPRINTS=AB:CD:...
# APP_DOWNLOAD_URL=https://example.com/sotto

# Metrics endpoint bearer token (endpoint disabled in production if unset)
# METRICS_TOKEN=your-secret-metrics-token

# CORS — comma-separated allowed origins (empty = block all cross-origin in prod)
# CORS_ORIGINS=https://your-domain.com

# Rate limiting
# Message sends per account: a token bucket of MESSAGE_BURST, refilled at MESSAGE_RATE_PER_MINUTE
MESSAGE_BURST=160
MESSAGE_RATE_PER_MINUTE=240
MAX_PENDING_MESSAGES_PER_USER=1000

# IP-based rate limit for unauthenticated endpoints (per worker, per minute)
# IP_RATE_LIMIT=30
# Number of uvicorn workers (IP rate limit is divided by this)
# UVICORN_WORKERS=1

# Pending message TTL (days) — messages older than this are purged hourly
# PENDING_MESSAGE_TTL_DAYS=30

# Request body limit (bytes)
# MAX_REQUEST_BODY_BYTES=2097152

# WebSocket idle timeout (seconds)
# WS_IDLE_TIMEOUT_SECONDS=300
# For phones without push (no Google Play services): their socket is all they have
# WS_NO_PUSH_IDLE_TIMEOUT_SECONDS=1800

# TURN server (coturn Docker container)
# Auto-detected from GCP metadata if unset. Override for non-GCP deployments.
# TURN_RELAY_IP=
# The address of the server's own network interface (its private address behind NAT).
# Auto-detected on GCP; set it elsewhere too (the same as TURN_RELAY_IP without NAT).
# TURN_INTERNAL_IP=
# Shared secret for ephemeral TURN credentials (must match coturn config)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TURN_SECRET=
# TURN_CREDENTIAL_TTL=3600

# Trusted proxy IPs that may set X-Forwarded-For (comma-separated)
# TRUSTED_PROXIES=127.0.0.1,::1

# --- Docker Compose only ---
# POSTGRES_PASSWORD=change-me-to-a-strong-random-password
# TLS_CERT_PATH=/path/to/fullchain.pem
# TLS_KEY_PATH=/path/to/privkey.pem
# The relay's name, as in its certificate (several comma-separated). nginx then answers only
# that name: a connection that asks for none or another one is refused before the certificate
# is sent, so scanners that sweep IP addresses learn nothing, not even the name.
# RELAY_HOSTNAME=relay.example.com

# Encrypted attachments (ADR-29): files go straight from phone to an S3-compatible bucket
# and back, with URLs this relay signs; it never carries their bytes. Leave empty for none.
# The author's relay uses Tigris (free egress; without a card it stops at its free tier):
# a private single-region bucket with a 30-day expiry rule, and a ReadWrite key for that
# bucket only, with "default permissions" off.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET=
# S3_REGION=auto
# Largest file, one account's 30-day allowance, the bucket's total, uploads per 30 days.
# ATTACHMENT_MAX_BYTES=104857600
# ATTACHMENT_MONTHLY_BYTES_PER_USER=2147483648
# ATTACHMENT_STORE_LIMIT_BYTES=4294967296
# ATTACHMENT_MONTHLY_UPLOADS=5000
# Parts for large uploads (resumable), and how long an uncollected file is kept.
# ATTACHMENT_PART_BYTES=8388608
# ATTACHMENT_TTL_DAYS=30
